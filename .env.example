# 纯内网控制台默认关闭管理员 API 密钥。
# 如果以后开放公网，把 ADMIN_AUTH_ENABLED 改为 true 并设置高强度 ADMIN_API_KEY。
ADMIN_AUTH_ENABLED=false
ADMIN_API_KEY=

# 默认直接使用设备号识别用户，兼容现有 iOS / Android / Windows 客户端。
# 若以后客户端全面支持 Bearer 设备令牌，可改为 false 强制令牌鉴权。
ALLOW_LEGACY_DEVICE_AUTH=true

# 原生内购必须接入 Apple/Google 服务端收据校验后再开启；当前保持关闭
ENABLE_UNVERIFIED_NATIVE_RECHARGE=false

# 虎皮椒商户凭据，不要写进代码或提交到Git
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=

# 住宅代理密码仍会加密，但密钥由后端首次运行时自动生成，无需手动填写。
# 如需自管密钥仍可填写 RESIDENTIAL_PROXY_ENCRYPTION_KEY；留空则使用下方密钥文件。
RESIDENTIAL_PROXY_ENCRYPTION_KEY=
RESIDENTIAL_PROXY_KEY_FILE=residential_proxy.key

# 绑定、解绑或删除住宅出口时自动更新 3x-ui Xray 配置并重载。
RESIDENTIAL_XRAY_SYNC_ENABLED=true
RESIDENTIAL_PROXY_TEST_URL=https://ip.oxylabs.io/location
